# Copy to .env.local and fill in. Both values are PUBLIC by design (they ship in
# the browser bundle); data is protected by Row Level Security, not by secrecy.
# NEVER put the service_role key in any file of this repository.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
